% Shared layout for cv_en.tex / cv_de.tex — one-page, two-column CV style
% with a colored header banner (no photo).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}[2026/08/27 resume style]

\RequirePackage{calc}

% -- package options ----------------------------------------------------
% \usepackage[size9]{resume} (size10/size9-5/size9/size8-5/size8): shrink
% body text -- and, since almost all spacing in this file is em-based,
% proportionally everything else too. scripts/generate.py steps through
% these as a last-resort fallback to keep the CV on one page.
\newlength{\cv@basept}
\setlength{\cv@basept}{10pt}
\DeclareOption{size10}{\setlength{\cv@basept}{10pt}}
\DeclareOption{size9-5}{\setlength{\cv@basept}{9.5pt}}
\DeclareOption{size9}{\setlength{\cv@basept}{9pt}}
\DeclareOption{size8-5}{\setlength{\cv@basept}{8.5pt}}
\DeclareOption{size8}{\setlength{\cv@basept}{8pt}}
\ProcessOptions\relax

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[left=1.6cm,right=1.6cm,top=1.2cm,bottom=1.2cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
% expansion=false: font expansion needs scalable Type1/OTF fonts (e.g.
% cm-super), which minimal TeX Live installs (like CI) may lack. Protrusion
% alone (still enabled) needs no such fonts and covers most of the benefit.
\RequirePackage[expansion=false]{microtype}
\RequirePackage{tikz}
\RequirePackage{hyperref}

% -- font-size scale ------------------------------------------------------
% Redefine the size commands relative to \cv@basept instead of the document
% class's fixed 10/11/12pt steps, driven by the size* options above.
\newlength{\cv@sz}
\newlength{\cv@bl}
\newcommand{\cv@fontsize}[2]{%
  \setlength{\cv@sz}{#1\cv@basept}%
  \setlength{\cv@bl}{#2\cv@basept}%
  \fontsize{\cv@sz}{\cv@bl}\selectfont
}
\renewcommand{\scriptsize}{\cv@fontsize{0.7}{0.84}}
\renewcommand{\footnotesize}{\cv@fontsize{0.8}{0.96}}
\renewcommand{\small}{\cv@fontsize{0.9}{1.08}}
\renewcommand{\normalsize}{\cv@fontsize{1.0}{1.2}}
\renewcommand{\large}{\cv@fontsize{1.1}{1.32}}
\renewcommand{\Large}{\cv@fontsize{1.3}{1.56}}
\renewcommand{\LARGE}{\cv@fontsize{1.5}{1.8}}
\renewcommand{\huge}{\cv@fontsize{1.8}{2.16}}
\renewcommand{\Huge}{\cv@fontsize{2.0}{2.4}}
\AtBeginDocument{\normalsize}

% -- palette -----------------------------------------------------------
\definecolor{accent}{HTML}{1F4E5F}
\definecolor{muted}{HTML}{555555}
\definecolor{rule}{HTML}{C9D3D6}

\hypersetup{
  colorlinks=true,
  linkcolor=accent,
  urlcolor=accent,
  pdfcreator={LaTeX},
}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\renewcommand{\familydefault}{\sfdefault}

% -- section headings ---------------------------------------------------
% Explicit \vspace in the before-code (rather than relying on titlesec's
% \titlespacing "before" value, which is internally an \addvspace and can
% collapse to near-zero straight after plain paragraph text) guarantees a
% real minimum gap above every section heading, no matter what precedes it.
\titleformat{\section}
  {\large\bfseries\color{accent}}
  {}{0em}
  {\vspace{0.9em}}
  [{\color{rule}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{0pt}{0.5em}

% -- two-column body geometry -------------------------------------------
\newlength{\cvsidebarwidth}
\setlength{\cvsidebarwidth}{5.3cm}
\newlength{\cvgutter}
\setlength{\cvgutter}{0.7cm}
\newlength{\cvmainwidth}
\setlength{\cvmainwidth}{\textwidth-\cvsidebarwidth-\cvgutter}

\newenvironment{cvsidebar}{%
  \begin{minipage}[t]{\cvsidebarwidth}
}{%
  \end{minipage}%
}
\newenvironment{cvmain}{%
  \begin{minipage}[t]{\cvmainwidth}
}{%
  \end{minipage}
}
\newcommand{\cvcolgap}{\hspace{\cvgutter}}

% -- header banner ----------------------------------------------------------
% \cvbanner{Name}{Tagline}{InfoBlock}
% InfoBlock is pre-formatted LaTeX (built by scripts/generate.py from
% personal.json / personal.public.json) -- a two-column list of
% contact/personal details, already laid out using \cvbannertextwidth.
\newlength{\cvbannertextwidth}
\setlength{\cvbannertextwidth}{\textwidth-20pt}

\newcommand{\cvbanner}[3]{%
  \noindent
  \begin{tikzpicture}
    \node[fill=accent, rounded corners=5pt, inner sep=10pt,
          text width=\dimexpr\textwidth-20pt\relax] (banner) {%
      \color{white}%
      \hypersetup{urlcolor=white, linkcolor=white}%
      \begin{minipage}[c]{\cvbannertextwidth}
        {\LARGE\bfseries #1}\\[0.2em]
        {\small #2}\\[0.35em]
        {\footnotesize #3}
      \end{minipage}%
    };
  \end{tikzpicture}\\[0.5em]
}

% -- entries (education / experience / projects) --------------------------
% \cventry{Title/Role}{Organization}{Dates}
\newcommand{\cventry}[3]{%
  \vspace{0.3em}
  \noindent
  \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
    \textbf{#1} & {\small\color{muted}#3} \\
  \end{tabular*}\\[-0.2em]
  {\small\itshape\color{muted}#2}\\[0.2em]
}

\newlist{cvitems}{itemize}{1}
\setlist[cvitems]{
  label=\textbullet,
  leftmargin=1.1em,
  itemsep=0.25em,
  parsep=0pt,
  topsep=0.25em,
  after=\vspace{0.5em}
}

% -- skills (stacked style for the narrow sidebar column) -------------------
% \cvskill{Category}{Items}
\newcommand{\cvskill}[2]{%
  \noindent{\small\bfseries\color{accent}#1}\\[0.15em]
  {\small\color{muted}#2}\\[0.7em]
}

\endinput
